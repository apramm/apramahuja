# Copy to .env for local runs (.env is gitignored; never commit it). In CI these are GitHub Actions secrets.
# Run a sync locally with:  node --env-file=.env scripts/sync-strava.mjs

# Strava API application "Client ID" (https://www.strava.com/settings/api; set Authorization Callback Domain to localhost)
STRAVA_CLIENT_ID=
# Strava API application "Client Secret" (server-side only; never in frontend code)
STRAVA_CLIENT_SECRET=
# Long-lived refresh token from `node scripts/strava-auth.mjs --code <code>` (scope read,activity:read:
# public + followers activities only; the sync further publishes only visibility "everyone").
# If Strava rotates it, the sync logs ::error:: and fails; re-run strava-auth and update the secret.
STRAVA_REFRESH_TOKEN=

# Hevy API key (Hevy Pro: https://hevy.com/settings?developer)
HEVY_API_KEY=
# IANA time zone for Hevy workout dates (Hevy reports UTC). Default: America/Vancouver
SITE_TZ=

# Last.fm API key (https://www.last.fm/api/account/create); read-only
LASTFM_API_KEY=
# Optional Last.fm username; defaults to params.lastfm.user in hugo.yaml
LASTFM_USER=
